# Copy to .env (git-ignored). All variables take the STREAMSENSE_API_ prefix.

# --- Production: media in S3 (persistent, shared by API and GPU workers), Postgres ---------
# STREAMSENSE_API_MEDIA_BACKEND=s3
# STREAMSENSE_API_S3_BUCKET=<private bucket>
# STREAMSENSE_API_S3_PREFIX=streamsense/
# STREAMSENSE_API_S3_REGION=us-east-1
# STREAMSENSE_API_DB_URL=postgresql+psycopg://user@host/streamsense
# AWS credentials: instance/task role (preferred) or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY

# --- PACE dev: local media on scratch (persistent; never /tmp, which is node-local) --------
STREAMSENSE_API_DATA_DIR=/home/hice1/<user>/scratch/streamsense/api-data
STREAMSENSE_API_MEDIA_BACKEND=local

# --- Model -------------------------------------------------------------------------------
STREAMSENSE_API_BACKEND=dummy
# STREAMSENSE_API_BACKEND=streamsense
# STREAMSENSE_API_RUN_DIR=/home/hice1/<user>/scratch/streamsense/outputs/E-07c/20261115T171807_212a7d93
# STREAMSENSE_API_STREAMSENSE_REPO=<repo>/ml
# STREAMSENSE_API_EMBEDDED_WORKER=false   # run `python -m app.worker` on the GPU host

# --- Access ------------------------------------------------------------------------------
# STREAMSENSE_API_AUTH_MODE=session        # default; "off" only for local scripts/tests
# STREAMSENSE_API_COOKIE_SECURE=true       # behind HTTPS
# STREAMSENSE_API_TOKEN=<shared secret>    # optional extra gate for a proxy in front of the API
