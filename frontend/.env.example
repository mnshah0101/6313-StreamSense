# Copy to .env.local (git-ignored) and adjust.

# Option 1 (recommended on PACE): browser -> this dev server -> API. Only port 5173 is forwarded.
VITE_API_URL=/api
STREAMSENSE_API_ENDPOINT_FILE=/home/hice1/<user>/scratch/streamsense/api-data/endpoint
# STREAMSENSE_API_TARGET=http://127.0.0.1:8000     # instead of the endpoint file
# STREAMSENSE_API_TOKEN=<same value as the API's STREAMSENSE_API_TOKEN>

# Option 2: browser calls the API directly (API must allow this origin via CORS, no token).
# VITE_API_URL=http://127.0.0.1:8000
